# ========================
# iz — Environment Config
# ========================
#
# Bu dosya örnek konfigürasyondur. Gerçek değerlerle .env dosyası oluşturun.
# .env dosyası .gitignore ile git'ten hariç tutulmuştur — ASLA commit etmeyin!
#
# Yeni kurulum:
#   cp .env.example .env
#   # Ardından her secret'ı güçlü rastgele değerle doldurun:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"  # string secret
#   python3 -c "import secrets; print(secrets.token_hex(32))"      # hex key

# --- App ---
APP_ENV=development
APP_PORT=8080
APP_SECRET=change-me-in-production-min-32-chars!!

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iz_db
DB_USER=iz_user
DB_PASSWORD=iz_password
DB_SSL_MODE=disable
DB_MAX_CONNS=25

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=iz_minio_access
MINIO_SECRET_KEY=iz_minio_secret_change_me
MINIO_USE_SSL=false
MINIO_BUCKET_MEDIA=iz-media
MINIO_BUCKET_AVATARS=iz-avatars

# --- Message TTL (Bekleyen mesaj süresi) ---
MSG_DEFAULT_TTL_DAYS=30
MSG_MAX_TTL_DAYS=90
MSG_MIN_TTL_DAYS=1

# --- Invite System ---
INVITE_USER_MONTHLY_LIMIT=5
INVITE_USER_CODE_MAX=5
INVITE_CODE_LENGTH=8

# --- Crypto ---
# Argon2id params (key derivation)
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
# 256-bit master key for envelope encryption — üret: python3 -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=change-me-generate-with-python-secrets-token-hex-32

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_API_URL=https://api.no-iz.app
NEXT_PUBLIC_WS_URL=wss://api.no-iz.app/api/ws
